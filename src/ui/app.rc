// Application icon resource. ASCII-only comments (same rule as build.cmd).
// Icon ID 1: window class icon (LoadIconW(instance, MAKEINTRESOURCE(1)))
// and the Explorer / taskbar icon (first icon in the exe is the file icon).
1 ICON "app.ico"

1 VERSIONINFO
 FILEVERSION 0,4,0,0
 PRODUCTVERSION 0,4,0,0
 FILEOS 0x40004
 FILETYPE 0x1
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "FileDescription", "DXL - DLSS eXtended Loader\0"
   VALUE "ProductName", "DXL\0"
   VALUE "FileVersion", "0.4\0"
   VALUE "ProductVersion", "0.4\0"
   VALUE "OriginalFilename", "DXL.exe\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x409, 1200
 END
END
